# Automate environment variables
# Copy this file to .env and adjust values for your environment.

# Server
PORT=3000

# Local model / inference backend
OLLAMA_HOST=http://localhost:11434
AUTOMATE_MODEL=llama3.1
AUTOMATE_ENDPOINT=http://localhost:11434
AUTOMATE_TEMPERATURE=0.7
AUTOMATE_MAX_TOKENS=4096

# Database
DATA_DIR=./data
DATABASE_URL=./data/automate.db

# Vault / credential encryption
VAULT_DB_PATH=.automate-vault.db
# Optional: set to auto-unlock vault at startup
VAULT_PASSWORD=

# API authentication (optional — set in production for secured access)
AUTOMATE_API_KEY=

# Shared secret for service-to-service auth (required for unified mode)
AUTOMATE_SERVICE_SECRET=

# API safety limits
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Optional dashboard MCP connector
# Enable with FEATURE_MCP_CLIENT=true
DASHBOARD_MCP_URL=
DASHBOARD_MCP_API_KEY=

# Feature flags
FEATURE_MCP_CLIENT=false

# Unified platform integration (set to true to enable)
# FEATURE_DASHBOARD_CONNECTOR=false
# FEATURE_UNIFIED_HEALTH=false

# Dashboard API URL for forwarding run results (optional)
# Set to enable Automate → Dashboard result forwarding
DASHBOARD_API_URL=
