NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_APP_URL=http://localhost:5173
DATABASE_URL=postgresql://automate:local-only@localhost:55432/automate
COOKIE_SECRET=replace-with-at-least-32-characters
VAULT_SECRET=replace-with-at-least-32-characters
AUTOMATE_API_KEY=replace-with-a-bootstrap-key
REPORTER_SECRET=replace-with-a-reporter-secret
# Set to 1 to run without COOKIE_SECRET and AUTOMATE_API_KEY. The fallback is a
# literal published in this repository, so it is a publicly known signing key on
# any host other than your own machine. Never set this in production: the
# startup policy rejects the development literals there regardless.
AUTOMATE_ALLOW_DEV_SECRETS=
AUTOMATE_API_URL=http://127.0.0.1:3000
RUNNER_INSTANCE_ID=00000000-0000-4000-8000-000000000002
RUNNER_REGISTRATION_SECRET=replace-with-a-runner-registration-secret
RUNNER_SLOTS=1
RUNNER_ALLOWED_TARGET_URLS=http://127.0.0.1:5173
RUNNER_PLAYWRIGHT_PROJECTS=smoke-pass,smoke-failure
ARTIFACT_ROOT=./var/artifacts
ARTIFACT_READ_FALLBACK_ROOT=
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=
OBJECT_STORE_REGION=
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
OBJECT_STORE_FORCE_PATH_STYLE=
OBJECT_STORE_ALLOW_INSECURE=
OBJECT_STORE_MAX_BYTES=
OBJECT_STORE_TIMEOUT_MS=
WORKER_INSTANCE_ID=00000000-0000-4000-8000-000000000001
WORKER_CAPABILITIES=playwright
WORKER_LABELS=reference
WORKER_SLOTS=1
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_DURATION_MS=30000
WORKER_MAX_ATTEMPTS=2
KILO_GATEWAY_URL=
KILO_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
SESSION_TTL_HOURS=24
SESSION_RETENTION_DAYS=30
SSE_REPLAY_RETENTION_HOURS=24
AUDIT_RETENTION_DAYS=365
RETENTION_SWEEP_INTERVAL_SECONDS=3600

# Sentry. Every value here is optional: with SENTRY_DSN unset the API never
# initialises the SDK and makes no outbound calls, and the web build ships no
# SDK behaviour. The DSN is a public ingest key, not a credential, which is why
# it is safe in the browser bundle.
#
# What the SDK is allowed to collect is set in code
# (apps/api/src/observability/sentry.ts, apps/web/src/observability/sentry.ts),
# not here. Sentry v11 collects cookies, headers, bodies, bound query
# parameters and local variable values by default, and this API's stack has
# secrets in every one of those places.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=
# 0 to 1. Defaults to 0: errors are reported either way, and tracing costs
# quota. A malformed value is ignored rather than fatal.
SENTRY_TRACES_SAMPLE_RATE=
# Build-time only. Needed to upload source maps; the DSN cannot upload. Leave
# unset locally and in CI, and the Sentry Vite plugin disables itself.
SENTRY_AUTH_TOKEN=
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
