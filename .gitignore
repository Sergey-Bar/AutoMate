# Dependencies
node_modules/

# Build output
dist/
build/
.turbo/
*.tsbuildinfo

# VitePress build output and dependency-optimizer cache. `dist/` already covers the
# output; the cache resolves to `node_modules/.vitepress`, which `node_modules/`
# covers. Listed because the first attempt assumed a `.vitepress/cache` path that
# does not exist, and an ignore rule whose comment states a false fact is worse
# than no rule.
site/.vitepress/cache/
site/.vitepress/dist/

# Environment
# `.env.*` covers every real environment file, so the two placeholder files have
# to be excepted by name. `.env.compose.example` was added with the compose
# secret guards and was silently excluded by this rule, which would have left
# `${VAR:?set VAR}` in the compose files with no documented way to satisfy them.
.env
.env.*
!.env.example
!.env.production.example
!.env.compose.example

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Database
*.db
*.db-shm
*.db-wal
*.sqlite

# Temp / junk
Tempplaywright-mcp/
%TEMP%/
nul

# Legacy nested source checkout (root-only)
/AutoMate/

# Auth and runtime credentials
**/auth.json
**/.automate/

# Sisyphus agent state
.sisyphus/

# OpenCode agent state
.omo/

# Coverage and test output
coverage/
test-results/
playwright-report/
blob-report/
.artifacts/
var/

# Vitest cache
.vite/
