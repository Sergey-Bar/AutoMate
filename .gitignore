# Dependencies
node_modules/

# Build output
dist/
build/
.turbo/
*.tsbuildinfo

# Storybook's static build. Not under `dist/` because `storybook build` writes to
# `packages/ui/storybook-static` — its own `default`, not a configured `outDir`, so
# there is no config key to point somewhere already ignored.
storybook-static/

# `site/` needs nothing here. Its build output is `site/dist` (covered by `dist/`
# above, which `outDir: 'dist'` in site/.vitepress/config.mts exists to make true)
# and VitePress's dependency cache is under `node_modules` (covered above). An
# earlier revision of this file listed `site/.vitepress/cache/`, explained in its
# own comment that the path did not exist, and then kept it anyway.

# Environment
# `.env.*` covers every real environment file, so the two placeholder files have
# to be excepted by name. `.env.compose.example` was added with the compose
# secret guards and was silently excluded by this rule, which would have left
# `${VAR:?set VAR}` in the compose files with no documented way to satisfy them.
.env
.env.*
!.env.example
!.env.production.example
!.env.compose.example

