{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    // `node` as well as `vitest/globals`: the event-name ownership test reads
    // `node:fs`, `node:path` and `node:url` to walk the workspace. Without the
    // node types those imports do not resolve, which is why the test used to be
    // excluded from the typecheck rather than fixed.
    "types": ["node", "vitest/globals"],
    "rootDir": "./src",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  // Tests are included here, matching every other package: they were excluded,
  // which meant `pnpm typecheck` never looked at them and the type-aware ESLint
  // rules could not find the files at all. `tsconfig.build.json` excludes them so
  // they never ship.
  "exclude": ["node_modules", "dist"]
}
