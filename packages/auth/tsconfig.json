{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    "types": ["node", "vitest/globals"],
    "rootDir": "./src",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  // Tests are included here, matching every other package. They were excluded,
  // which meant `pnpm typecheck` never looked at them and the type-aware ESLint
  // rules could not find the files at all. `tsconfig.build.json` is the one that
  // excludes them, so they never ship.
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
