{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    // `vitest/globals` alongside `node`: the schema test was invisible to the
    // typecheck precisely because it was excluded, so its globals were never
    // declared anywhere.
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*"],
  // Tests are included here, matching every other package: they were excluded,
  // which meant `pnpm typecheck` never looked at them and the type-aware ESLint
  // rules could not resolve the files at all. `tsconfig.build.json` excludes them
  // so they never ship.
  "exclude": ["node_modules", "dist"]
}
