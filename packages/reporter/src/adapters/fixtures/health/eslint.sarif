          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "file:///C:/work/repo/src/util.js", "index": 0 },
                "region": { "startLine": 4, "startColumn": 7 }
              }
            }
          ],
          "ruleId": "no-unused-vars",
          "ruleIndex": 0
        },
        {
          "level": "warning",
          "message": { "text": "'other' is defined but never used." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "file:///C:/work/repo/src/util.js", "index": 0 },
                "region": { "startLine": 9, "startColumn": 7 }
              }
            }
