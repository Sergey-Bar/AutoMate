# docker/.env.example — Production Compose Environment Variables
# Copy to docker/.env and fill in all REQUIRED values before running:
#   cp docker/.env.example docker/.env
#   docker compose -f docker/docker-compose.prod.yml --env-file docker/.env up -d
#
# Variables marked REQUIRED must be set. Variables with defaults are optional.
# NEVER commit docker/.env to version control.

# ─── PostgreSQL ──────────────────────────────────────────────────────────────

# Database name (default: automate)
POSTGRES_DB=automate

# Database user (default: automate)
POSTGRES_USER=automate

# REQUIRED: Strong database password — no default, must be set
POSTGRES_PASSWORD=

# ─── API Server (Fastify — port 3000) ────────────────────────────────────────

# REQUIRED: Full PostgreSQL connection string for the API server
# Format: postgresql://<user>:<password>@postgres:5432/<db>
DATABASE_URL=postgresql://automate:CHANGE_ME@postgres:5432/automate

# REQUIRED: Secret used to sign httpOnly session cookies (min 32 random chars)
# Legacy alias supported by runtime: SESSION_SECRET
COOKIE_SECRET=

# REQUIRED: Secret used for AES-256-GCM vault encryption (min 32 random chars)
VAULT_SECRET=

# REQUIRED: API key for authenticating requests to the Automate server
AUTOMATE_API_KEY=

# CORS allowed origin — set to your public domain in production
CORS_ORIGIN=http://localhost:80

# Ollama host for AI model inference
# Use http://host.docker.internal:11434 when Ollama runs on the Docker host (default)
# Use http://ollama:11434 if running Ollama as a Docker service
OLLAMA_HOST=http://host.docker.internal:11434

# ─── Webwright Sidecar (FastAPI — port 8000) ─────────────────────────────────

# Internal URL the API server uses to reach the Webwright sidecar
WEBWRIGHT_URL=http://webwright:8000

# Optional API key for Webwright service authentication
WEBWRIGHT_API_KEY=

# ─── Nginx (public entry point) ───────────────────────────────────────────────

# Host port nginx listens on (default: 80)
HTTP_PORT=80

# ─── Image Tags (optional — override built image names) ──────────────────────

# API_IMAGE=automate/api:1.0.0
# WEB_IMAGE=automate/web:1.0.0
# WEBWRIGHT_IMAGE=automate/webwright:1.0.0
