{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "turbo.json",
    "tsconfig*.json",
    "eslint.config.js",
    ".prettierrc",
    ".prettierignore",
    "vitest.config.ts",
    "vitest.shared.ts",
    "playwright.config.ts",
    "commitlint.config.js",
    "coverage-baseline.json",
    "docs/quality/complexity-baseline.json",
    "docs/quality/findings-ledger.json",
    "docs/quality/findings-status.json",
    "scripts/gate-tooling.json",
    ".semgrep.yml",
    ".gitleaks.toml",
    ".jscpd.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {},
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@automate/ui#build": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
