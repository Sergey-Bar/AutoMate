# Dependencies
node_modules/

# Build output
dist/
.turbo/

# TypeScript build cache
*.tsbuildinfo

# Vite compiled config (source is vite.config.ts)
vite.config.js
vite.config.d.ts

# TanStack Router temp files
.tanstack/

# TanStack Router generated route tree (regenerated on build/dev)
apps/client/src/routeTree.gen.ts

# Database
*.db
*.db-journal
*.db-shm
*.db-wal

# Runtime data directory (SQLite databases + blob uploads)
apps/server/data/
!apps/server/data/.gitkeep

# Test output
test-results/
test-results-full.json
playwright-report/

# Environment
.env
.env.local

# Logs
server.log
*.log

# Archive (old reports, debug scripts)
archive/

# OS artifacts
nul
nul_artifact

# IDE
.vscode/

# AI / Agent session artifacts
.sisyphus/
.planning/

# Claude skills (duplicated in subpackages — keep root only)
apps/client/.claude/
apps/server/.claude/

# Git worktrees
.worktrees/

 # Sentinel config (may contain API keys)
.sentinel/

# Test coverage
coverage/

# Mission control (integration credentials: Slack webhooks, Jira tokens, etc.)
apps/server/.mission-control/

# Tooling artifacts
.autoqa-progress.json
.autopilot-progress.json

# Stryker mutation testing
stryker-tmp/
.stryker-tmp/
mutation-report.html
mutation-report.json

# E2E seeded data (generated by global-setup)
e2e/seeded-runs.json
