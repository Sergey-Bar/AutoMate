# Automate Environment Variables
# Copy this file to .env and fill in your values

# Fastify server port
PORT=4000

# WebSocket reporter port (for test result ingestion)
REPORTER_PORT=4001

# Server bind address
HOST=0.0.0.0

# Environment mode (development or production)
NODE_ENV=development

# Allowed CORS origins (restrict to your domain in production)
CORS_ORIGIN=http://localhost:5173

# SQLite database directory
DATA_DIR=./data

# Test artifacts storage directory
ARTIFACTS_DIR=./test-results

# Automate reporter WebSocket URL (for connecting from test runners)
AUTOMATE_DASHBOARD_URL=ws://localhost:4001

# Sentry error tracking DSN (optional - leave empty to disable)
SENTRY_DSN=

# Server log level (debug, info, warn, error)
LOG_LEVEL=info

# Public URL for notification links (e.g., in Slack messages, GitHub notifications)
# Set this to your domain when deploying behind a reverse proxy
PUBLIC_DASHBOARD_URL=

# Required in production: secret used to sign session cookies (HMAC)
# Must be set to a strong random value — server will refuse to start without it
COOKIE_SECRET=

# Required in production: API key for dashboard login
# Must not be 'changeme' — server will refuse to start with the default
AUTOMATE_DASHBOARD_API_KEY=

# Shared secret for service-to-service auth (required for unified mode)
AUTOMATE_SERVICE_SECRET=

# Optional: shared secret for reporter WebSocket authentication
# Set this in production to prevent unauthorized test data injection
REPORTER_SECRET=

# Result callback to Automate (requires FEATURE_RESULT_CALLBACK=true)
AUTOMATE_CALLBACK_URL=http://localhost:3000

# Feature flags (set to true/false to override defaults)
#
# Unified platform integration (set to true to enable)
# FEATURE_EXTERNAL_TRIGGER=false
# FEATURE_RESULT_CALLBACK=false
#
# --- Flags enabled by default (v2.0 graduates) ---
# These are ON by default. Set to false to opt out.
# FEATURE_AI_EXPLAIN=true
# FEATURE_NL_QUERY=true
# FEATURE_SCHEDULED_RUNS=true
# FEATURE_CODEGEN_LAUNCHER=true
# FEATURE_TERMINAL_RUNNER=true
# FEATURE_AUTO_QUARANTINE=true
# FEATURE_BASELINE_MANAGEMENT=true
#
# --- Flags enabled by default (v2.1 graduates) ---
# These graduated in v2.1 and are ON by default. Set to false to opt out.
# FEATURE_FAILURE_TAXONOMY=true
# FEATURE_PREDICTIVE_TEST_SELECTION=true
# FEATURE_SCREENSHOT_DIFF=true
# FEATURE_LOOKS_SAME_DIFF=true
# FEATURE_CROSS_RUN_CLUSTERS=true
# FEATURE_RISK_SCORING=true
# FEATURE_AUDIT_TRAIL=true
# FEATURE_PER_WORKSPACE_GATES=true
# FEATURE_QUARANTINE_APPROVAL=true
# FEATURE_ROI_METRICS=true
# FEATURE_LOCATOR_INTELLIGENCE=true
# FEATURE_TEST_GENERATION=true
#
# --- Flags disabled by default (experimental / incomplete) ---
# Uncomment and set to true to enable.
# FEATURE_MCP_SERVER=false
# FEATURE_MCP_GATEWAY=false
# FEATURE_MCP_PLAYWRIGHT=false
# FEATURE_ROLE_BASED_VIEWS=false
# FEATURE_SPEC_AWARE_TRIAGE=false
# FEATURE_FREQUENT_FAILURES=false
# FEATURE_CHECKS_ANNOTATIONS=false
# FEATURE_RBAC=false
# FEATURE_SSO=false
