{
  "name": "@automate/reporter",
  "version": "1.0.0",
  "description": "Playwright test reporter for Automate",
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --passWithNoTests",
    "attw": "attw --pack .",
    "publint": "publint"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^4.0.0",
    "tsup": "^8.4.0",
    "typescript": "~5.9",
    "vitest": "^4.0.0"
  },
  "keywords": ["playwright", "reporter", "Automate", "testing", "dashboard"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Automate-hq/Automate.git",
    "directory": "packages/reporter"
  },
  "homepage": "https://github.com/Automate-hq/Automate#connect-your-tests",
  "bugs": {
    "url": "https://github.com/Automate-hq/Automate/issues"
  },
  "author": "Automate-hq",
  "publishConfig": {
    "access": "public"
  }
}
