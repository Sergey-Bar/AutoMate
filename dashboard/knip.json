{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "license-checker-rseidelsohn",
    "ISC",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "Apache-2.0",
    "0BSD",
    "CC0-1.0",
    "CC-BY-3.0",
    "CC-BY-4.0",
    "Unlicense",
    "Python-2.0",
    "BlueOak-1.0.0"
  ],
  "ignoreDependencies": [
    "@stryker-mutator/core",
    "@stryker-mutator/typescript-checker",
    "@stryker-mutator/vitest-runner",
    "@stryker-mutator/command-runner",
    "lint-staged"
  ],
  "workspaces": {
    "apps/server": {
      "project": ["src/**/*.ts"]
    },
    "apps/client": {
      "entry": ["src/routes/**/*.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "packages/reporter": {
      "project": ["src/**/*.ts"]
    },
    "packages/cli": {
      "project": ["src/**/*.ts"]
    }
  }
}
