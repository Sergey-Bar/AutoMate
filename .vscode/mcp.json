{
  "servers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "k6": {
      "type": "stdio",
      "command": "C:\\Users\\Sergey\\go\\bin\\mcp-k6.exe",
      "args": []
    },
    "a11y": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "a11y-mcp-server@latest"]
    },
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "appium": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "appium-mcp@latest"]
    },
    "snyk": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "snyk@latest", "mcp", "-t", "stdio"],
      "env": {
        "SNYK_TOKEN": "${SNYK_TOKEN}"
      }
    }
  }
}
