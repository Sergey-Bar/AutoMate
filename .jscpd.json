{
  "threshold": 3,
  "reporters": ["console", "json"],
  "output": "./var/jscpd",
  "minLines": 10,
  "minTokens": 50,
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/var/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/blob-report/**",
    "**/.turbo/**",
    "**/.git/**",
    "**/.kilo/**",
    "**/*.d.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/__tests__/**"
  ],
  "formats": ["typescript", "tsx", "javascript"]
}
