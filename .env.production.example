# Automate — Production environment
# Production environment — DO NOT use defaults in production
#
# Copy this file to .env and replace ALL placeholder values before deploying.
# Never commit the actual .env file to version control.

# ─── Server ───────────────────────────────────────────────────────────────────

# Server port
PORT=3000

# Allowed CORS origin — MUST be set to your actual domain in production.
# Never use * in production; it allows any origin to call your API.
CORS_ORIGIN=https://your-domain.com

# ─── API Authentication ────────────────────────────────────────────────────────

# REQUIRED: API key for authenticated access to the Automate API.
# Generate a strong random value, e.g.: openssl rand -hex 32
AUTOMATE_API_KEY=change-me-to-a-strong-random-key

# ─── AI / Inference Backend ───────────────────────────────────────────────────

# Ollama base URL (update if Ollama runs on a different host or port)
OLLAMA_HOST=http://localhost:11434

# LLM model to use
AUTOMATE_MODEL=llama3.1

# Model endpoint (usually the same as OLLAMA_HOST)
AUTOMATE_ENDPOINT=http://localhost:11434

# Generation temperature (0.0–1.0)
AUTOMATE_TEMPERATURE=0.7

# Maximum output tokens per response
AUTOMATE_MAX_TOKENS=4096

# ─── Cloud AI Providers (Optional) ────────────────────────────────────────────
# Set an API key to enable the corresponding provider.
# See docs/ai-provider-support-matrix.md for details.

# Tier 1: Native SDK
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Tier 2: OpenAI-compatible
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# COHERE_API_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────

# Directory where SQLite databases are stored
DATA_DIR=./data

# Path to the main application database
DATABASE_URL=./data/automate.db

# ─── Vault / Credential Encryption ───────────────────────────────────────────

# Path to the encrypted vault database
VAULT_DB_PATH=.automate-vault.db

# OPTIONAL: Auto-unlock the vault on startup.
# If set, the vault is decrypted automatically without a manual unlock step.
# Leave empty to require manual unlock via the UI or API.
# VAULT_PASSWORD=

# ─── Rate Limiting ────────────────────────────────────────────────────────────

# Maximum number of requests per window per IP
RATE_LIMIT_MAX=100

# Rate limit window duration (e.g. "1 minute", "30 seconds")
RATE_LIMIT_WINDOW=1 minute

# ─── MCP Connector (Optional) ─────────────────────────────────────────────────

# Enable the MCP client feature flag to use these settings
# FEATURE_MCP_CLIENT=false
# DASHBOARD_MCP_URL=
# DASHBOARD_MCP_API_KEY=

# ─── Feature Flags ────────────────────────────────────────────────────────────

# Set to true to enable the MCP client connector
FEATURE_MCP_CLIENT=false
