# Compose environment for the stacks in this repository.
#
# Placeholders only. Every value below must be replaced before the stack starts:
# the compose files use `${VAR:?set VAR}`, so Compose refuses to start when one
# is missing rather than falling back to a value committed in git.
#
# Generate the secrets with:
#   openssl rand -hex 32

POSTGRES_PASSWORD=replace-with-a-postgres-password

# At least 32 characters. Signs session cookies, so a value shared between
# installs is a publicly known signing key for each of them.
COOKIE_SECRET=replace-with-at-least-32-characters

# At least 32 characters. Wraps the vault.
VAULT_SECRET=replace-with-at-least-32-characters

# At least 32 characters. The bootstrap credential for the API. Every secret
# in this file has the same floor, because the floor lives in one place:
# `SECRET_MIN_LENGTH` in `packages/config`, which `apps/api/src/startup-policy.ts`
# imports rather than restating. They used to differ — 32 for the cookie and
# vault, 16 for the other four — and the weakest credential set the bar.
AUTOMATE_API_KEY=replace-with-a-bootstrap-key-32-chars

# At least 32 characters. Required by the reporter ingestion endpoint, which
# returns 503 while it is unset.
REPORTER_SECRET=replace-with-a-reporter-secret-32-chars

# At least 32 characters. Required to register a runner.
RUNNER_REGISTRATION_SECRET=replace-with-a-runner-registration-secret

# The object store, used by both stacks. The production API sets
# NODE_ENV: production, and `apps/api/src/startup-policy.ts` refuses to start
# without a durable object store — artifact bytes are evidence, and on one
# process's filesystem they disappear with it. The dev stack's API runs
# NODE_ENV: development and would have fallen back to ARTIFACT_ROOT, which is
# exactly why the missing wiring went unnoticed for so long.
#
# The bucket must already exist in the store: the compose files create the
# container and its volume, not the bucket.
OBJECT_STORE_BUCKET=automate-artifacts

# Any region string. MinIO ignores it; a real S3-compatible store does not.
OBJECT_STORE_REGION=us-east-1

# The object store's own credentials, used by the `minio` service both compose
# files declare. On the production stack these are also the API's
# OBJECT_STORE_ACCESS_KEY_ID and _SECRET_ACCESS_KEY, so they are the credential
# the deployment actually authenticates with — not a dev convenience.
MINIO_ROOT_USER=replace-with-an-object-store-access-key
MINIO_ROOT_PASSWORD=replace-with-an-object-store-secret-key
