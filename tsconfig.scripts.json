{
  // Allow JavaScript to be typechecked, and enable it for the scripts.
  //
  // The root project already claimed to include `scripts/**/*.ts`, which matches
  // nothing: every script in the repository is `.mjs`. So the preflight gate, the
  // coverage ratchet, the licence check, the secret scan, the OCI scripts and the
  // static-analysis runner — the checks that decide whether a commit is mergeable
  // — had no type checking at all, which is how a typo in a path or a wrong
  // argument count stayed invisible.
  //
  // `checkJs` costs nothing for `.mjs` (it is not part of the build) and turns
  // those scripts into checked code. The glob is deliberately broad rather than an
  // allowlist: a gate script that is excluded from type checking is a gate script
  // whose wrong argument count nothing catches, and the previous note here described
  // an allowlist that did not exist.
  "allowJs": true,
  "checkJs": true,

  // The scripts, plus the ambient declarations they need. `*.d.mts` is listed
  // explicitly because it matches neither `*.mjs` nor `*.ts`, and
  // `scripts/types/eslint-plugins.d.mts` declares the two untyped ESLint plugins that
  // `eslint.config.js` imports — which entered this program when
  // `scripts/complexity-eslint.config.mjs` began importing that config, so the gate's
  // own configuration is checked rather than trusted.
  "include": ["scripts/**/*.mjs", "scripts/**/*.d.mts", "vitest.shared.ts", "vitest.config.ts"],

  "compilerOptions": {
    // `.mjs` scripts run directly under Node, not through a bundler, so the
    // emit settings are irrelevant; only the checking matters.
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    // Scripts legitimately deal in `process.env` values that are
    // `string | undefined` and in argv-driven arguments.
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  }
}
