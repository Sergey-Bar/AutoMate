# ─── Automate Unified Platform — Environment Variables ────────────────────────
#
# Copy this file to .env and fill in the values before running:
#   cp .env.unified.example .env
#
# Then start the new platform stack:
#   docker compose -f docker-compose.unified.yml up api web postgres -d
#
# To include the Ollama AI service:
#   docker compose -f docker-compose.unified.yml --profile ai up -d
#
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────────────────────

# PostgreSQL connection URL used by the API and Drizzle ORM.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# Default (Docker Compose internal network): postgres://automate:automate@postgres:5432/automate
DATABASE_URL=  # Required for persistence. Generate password with: openssl rand -base64 32

# PostgreSQL root password (used by the postgres service in Docker Compose)
POSTGRES_PASSWORD=  # Required for Docker Postgres. Generate with: openssl rand -base64 32

# ─── API Server ───────────────────────────────────────────────────────────────

# Port the Hono API listens on inside the container (default: 3000)
PORT=3000

# CORS allowed origin — set to the URL where the web app is served.
CORS_ORIGIN=http://localhost:5173

# ─── Authentication / Security ────────────────────────────────────────────────

# Secret used to sign httpOnly session cookies. Must be at least 32 characters.
# REQUIRED in production. Generate with: openssl rand -base64 32
COOKIE_SECRET=

# Shared secret between the Playwright reporter and the API.
# Used to authenticate incoming WebSocket reporter connections.
# Generate with: openssl rand -base64 32
REPORTER_SECRET=

# Internal service-to-service shared secret.
# Generate with: openssl rand -base64 32
AUTOMATE_SERVICE_SECRET=

# API key required for authenticated access to the unified API.
# Leave empty for 'open mode' (development only).
# Generate with: openssl rand -base64 32
AUTOMATE_API_KEY=

# Master secret for vault credential encryption (AES-256-GCM). Must be at least 32 characters.
# Generate with: openssl rand -base64 32
VAULT_SECRET=

# ─── Ollama (AI — optional, enable with --profile ai) ────────────────────────

# Base URL for the Ollama API.
# When running via Docker Compose with --profile ai: http://ollama:11434
# When running Ollama on the host machine: http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434

# ─── Legacy Platform (Automate + Automate) ─────────────────────────

# API key for the legacy Automate server (optional — leave empty to disable).
# This is separate from the unified API key above.
AUTOMATE_API_KEY_LEGACY=

# API key for the legacy Automate (required for dashboard auth)
AUTOMATE_DASHBOARD_API_KEY=

# Ollama model to use (default: llama3.1)
# AUTOMATE_MODEL=llama3.1
