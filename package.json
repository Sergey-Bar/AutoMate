{
  "name": "automate",
  "version": "1.0.0",
  "private": true,
  "description": "Automate — AI-Orchestrated QA Platform",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "cross-env VITE_AUTH_REQUIRED=false turbo run dev --filter=@automate/api --filter=@automate/unified-web",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:automation:score": "node ./scripts/automation-score.mjs --run",
    "test:automation:score:json": "node ./scripts/automation-score.mjs --run --json",
    "test:automation:score:from-report": "node ./scripts/automation-score.mjs --from-report ./.artifacts/automation-playwright-report.json",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "unify:preflight": "node ./scripts/unify-preflight.mjs",
    "smoke:local": "node ./scripts/local-smoke.mjs",
    "smoke:local:json": "node ./scripts/local-smoke.mjs --json",
    "verify": "turbo run build test typecheck lint --filter=@automate/api --filter=@automate/unified-web --filter=@automate/db --filter=@automate/auth --filter=@automate/realtime --filter=@automate/shared-contracts --filter=@automate/ui",
    "security:scan": "pnpm audit --audit-level=high",
    "license:check": "node ./scripts/license-check.mjs"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.7",
      "esbuild": "0.25.12",
      "fast-uri": "3.1.2",
      "form-data": "4.0.6",
      "hono": "4.12.29",
      "js-yaml": "5.2.1",
      "undici": "7.28.0",
      "uuid": "11.1.1",
      "vite": "6.4.3",
      "ws": "8.21.0"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "cross-env": "^7.0.3",
    "jscpd": "^4.0.9",
    "license-checker-evergreen": "^6.2.1",
    "turbo": "^2.10.4"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
