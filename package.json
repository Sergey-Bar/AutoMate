{
  "name": "automate",
  "version": "3.1.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Automate — AI-Orchestrated QA Platform",
  "packageManager": "pnpm@11.28.4",
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev --filter=@automate/api --filter=@automate/unified-web",
    "dev:all": "turbo run dev --filter=@automate/api --filter=@automate/unified-web --filter=@automate/worker --filter=@automate/runner",
    "format": "prettier --no-error-on-unmatched-pattern \"**/*.{ts,tsx,mts,cts,js,mjs,cjs,vue,html}\" \"**/*.{json,yaml,yml,md,css}\" \".github/workflows/*.{yml,yaml}\" --write",
    "format:check": "prettier --no-error-on-unmatched-pattern \"**/*.{ts,tsx,mts,cts,js,mjs,cjs,vue,html}\" \"**/*.{json,yaml,yml,md,css}\" \".github/workflows/*.{yml,yaml}\" --check",
    "build": "turbo run build",
    "test": "turbo run test",
    "coverage:ratchet": "node ./scripts/coverage-ratchet.mjs",
    "mutation": "node ./scripts/mutation.mjs",
    "mutation:ratchet": "node ./scripts/mutation-ratchet.mjs",
    "test:contract": "turbo run test --filter=@automate/contract-tests",
    "test:runner": "turbo run test --filter=@automate/runner --filter=@automate/runner-sdk --filter=@automate/worker",
    "test:performance": "node ./scripts/performance-gate.mjs",
    "test:integration": "node --test --test-concurrency=1 scripts/lib/*.test.mjs tests/e2e/support/ports-agree.test.mjs local/test/bounded-read.test.mjs site/tests/*.test.mjs",
    "oci:build": "node ./scripts/oci-build.mjs",
    "oci:verify": "node ./scripts/oci-verify.mjs",
    "oci:smoke": "node ./scripts/oci-smoke.mjs",
    "typecheck": "pnpm typecheck:scripts && pnpm typecheck:e2e && turbo run typecheck",
    "typecheck:e2e": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test --project=vertical-slice --grep \"API\"",
    "test:e2e:vertical": "playwright test --project=vertical-slice",
    "test:e2e:profiles": "node ./scripts/profile-matrix.mjs",
    "test:render": "node ./scripts/render-budget.mjs",
    "render:baseline": "node ./scripts/render-baseline.mjs",
    "db:generate": "pnpm --filter @automate/db db:generate",
    "db:migrate": "pnpm --filter @automate/db db:migrate",
    "audit:verify": "pnpm --filter @automate/db audit:verify",
    "db:check": "pnpm --filter @automate/db exec drizzle-kit check",
    "compose:config": "docker compose -f infra/compose/docker-compose.unified.yml config",
    "compose:boot": "node ./scripts/compose-boot.mjs",
    "release:compose": "node ./scripts/release-compose.mjs",
    "release:bundle": "node ./scripts/release-bundle.mjs",
    "release:notes": "node ./scripts/release-notes.mjs",
    "release:visibility": "node ./scripts/release-visibility.mjs",
    "migrate:plan": "pnpm --filter @automate/migrate-cli build && node tools/migrate-cli/dist/index.js plan",
    "migrate:validate": "pnpm --filter @automate/migrate-cli build && node tools/migrate-cli/dist/index.js validate",
    "migrate:rehearse": "pnpm build && node ./scripts/migration-rehearse.mjs",
    "migrate:apply": "pnpm --filter @automate/migrate-cli build && node tools/migrate-cli/dist/index.js apply",
    "migrate:verify": "pnpm --filter @automate/migrate-cli build && node tools/migrate-cli/dist/index.js verify",
    "unify:preflight": "node ./scripts/unify-preflight.mjs",
    "smoke:local": "node ./scripts/local-smoke.mjs",
    "smoke:local:json": "node ./scripts/local-smoke.mjs --json",
    "smoke:rehearsal": "node ./scripts/migration-rehearsal.mjs",
    "security:scan": "pnpm audit --audit-level=high",
    "skill-scan": "node ./scripts/skill-scan.mjs",
    "tenancy:check": "node ./scripts/tenancy-check.mjs",
    "authz:check": "node ./scripts/authz-matrix.mjs",
    "authz:matrix": "node ./scripts/authz-matrix.mjs --write",
    "deps:policy": "node ./scripts/deps-policy.mjs",
    "security:secrets": "node ./scripts/secret-scan.mjs",
    "security:secrets:history": "node ./scripts/secret-scan.mjs --history",
    "license:check": "node ./scripts/license-check.mjs",
    "security:verify": "pnpm audit --audit-level=high && pnpm security:secrets:self-test && pnpm security:secrets && pnpm security:secrets:history && pnpm security:config-check && pnpm security:static && node ./scripts/license-check.mjs && pnpm duplication && pnpm complexity && pnpm docs:capability-register && pnpm findings:check",
    "findings:check": "node ./scripts/findings-check.mjs",
    "findings:baseline": "node ./scripts/findings-check.mjs --write",
    "status:10": "node ./scripts/status-ten.mjs",
    "verify": "pnpm unify:preflight && pnpm review:rules && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm coverage:ratchet && pnpm build && pnpm authz:check && pnpm db:check && pnpm tenancy:check && pnpm security:verify",
    "verify:local": "node ./scripts/verify-local.mjs",
    "verify:release": "pnpm verify && pnpm oci:verify",
    "security:static": "node ./scripts/static-analysis.mjs",
    "security:config-check": "node ./scripts/static-analysis-config-check.mjs",
    "security:secrets:self-test": "node ./scripts/secret-scan.mjs --self-test",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "duplication": "jscpd --config .config/jscpd.json",
    "complexity": "node ./scripts/complexity-gate.mjs",
    "review:rules": "node scripts/review/review-rules-check.mjs",
    "review:pr": "node scripts/review/review-pr.mjs",
    "complexity:baseline": "node ./scripts/complexity-gate.mjs --write",
    "quality:baseline": "node ./scripts/quality-baseline.mjs",
    "test:coverage": "turbo run test -- --coverage && node ./scripts/write-coverage-provenance-all.mjs",
    "coverage:provenance": "node ./scripts/write-coverage-provenance-all.mjs",
    "docs:capability-register": "node ./scripts/capability-register.mjs",
    "capability:evidence": "node ./scripts/capability-evidence.mjs",
    "site:generate": "node ./scripts/build-site-pages.mjs",
    "site:doctor": "node ./scripts/site-doctor.mjs",
    "docs:check": "node --test scripts/lib/docs-paths.test.mjs scripts/lib/docs-drift.test.mjs scripts/lib/ledger-json.test.mjs scripts/lib/blueprint-consistency.test.mjs scripts/lib/openapi-drift.test.mjs",
    "openapi:generate": "node ./scripts/openapi.mjs --write",
    "docs:dead-exports": "node --test scripts/lib/dead-exports.test.mjs",
    "docs:capability-register:baseline": "node ./scripts/capability-register.mjs --update-baseline"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "license-checker-evergreen": "^6.3.1",
    "pg": "catalog:",
    "prettier": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.28.4"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "tabWidth": 2,
    "printWidth": 100,
    "endOfLine": "lf",
    "arrowParens": "always"
  }
}
