{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedSideEffectImports": true,
    "libReplacement": false,
    "rootDir": ".",
    "types": []
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "site/**/*.ts",
    "vitest.config.ts",
    "vitest.shared.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "test-results",
    ".turbo",
    "scripts/**/*.mjs",
    "scripts/**/*.d.mts",
    "e2e/**/*.ts",
    "**/*.tsx"
  ]
}
